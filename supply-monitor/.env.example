# Banco da programação semanal (Supabase).
# A chave anon é pública por desenho: ela identifica o projeto e não
# autoriza nada sozinha. Quem protege os dados são as regras de acesso do
# banco, em supabase/schema.sql.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-public

# Consultoria por IA (opcional)
VITE_GEMINI_API_KEY=
